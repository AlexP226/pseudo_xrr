#   - tension = 0.028 N/m
#   - temperature = 293 K
#   - kappa = 18.74 +/- 8.26 kBT
#   - amin = 5 angstrom
#   call: GIXOS_background_corr(); GIXOS_qxy_dependence(); GIXOS2R(qxy0_select_idx=0,
